# Grok / SpaceXSI
XAI_API_KEY=

# Twilio (solo per "Chiama il cane")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# X API v2 (solo se si posta su X; OAuth utente)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Cane robot Unitree Go1 (free-dog-sdk, Wi-Fi del cane). Default 192.168.12.1
GO1_ADDR=192.168.12.1

# Cane robot Unitree Go2 via WebRTC (non usato: al museo c'è un Go1)
ROBOT_DOG_IP=
ROBOT_DOG_AES_KEY=

# Chat col cane nel simulatore (src/chat). Sostituisci il placeholder con la tua chiave OpenAI.
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
# OPENAI_BASE_URL=https://api.x.ai/v1   # opzionale: per usare Grok al posto di OpenAI (con XAI_API_KEY in OPENAI_API_KEY)
