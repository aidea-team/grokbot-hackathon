<mujoco model="g1 scene">
  <!-- Unitree G1 29 DoF (rev 1.0) from unitree_rl_gym (BSD-3): it already contains floor and lights. head_cam is ours. -->
  <include file="g1_29dof_rev_1_0.xml"/>
  <option timestep="0.002"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>
  <!-- Two fixed cylinders 4 m in front of the starting point (the robot starts at the origin facing +x; right = -y, left = +y): red to the
       right, blue to the left, 2.4 m apart and 1.2 m tall. They are the same after every reset. For the camera/chat tests (go to the red one, ...). -->
  <worldbody>
    <geom name="cyl_red" type="cylinder" size="0.12 0.60" pos="4 -1.2 0.60" rgba="0.90 0.10 0.10 1" friction="1 0.005 0.0001"/>
    <geom name="cyl_blue" type="cylinder" size="0.12 0.60" pos="4 1.2 0.60" rgba="0.10 0.30 0.95 1" friction="1 0.005 0.0001"/>
  </worldbody>
</mujoco>
